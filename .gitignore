*.tar
*.tar.gz
*.tgz
*.zip
*.rar
*.7z
*.gz
*.bz2
*.xz
*.war
*.jar
*.egg
*.egg-info/

# Cache and temporary files
*.tmp
*.temp
*.swp
*.swo
*.swn
*~

