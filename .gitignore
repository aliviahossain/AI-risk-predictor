/uploads/
uploads/
**/uploads/
*.log
*.log.*
*.pid
*.seed

# Node / frontend
frontend/node_modules/
frontend/build/
frontend/.cache/
frontend/dist/
frontend/.env
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# Visual Studio Code
.vscode/
.history/

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
desktop.ini

