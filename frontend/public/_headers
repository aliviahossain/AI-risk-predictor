# Netlify response headers. Read for both Git-linked builds and manual
# drag-and-drop deploys (netlify.toml is ignored by the latter).

# Build output in /static is content-hashed, so it can be cached forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML entry point must always be revalidated so new deploys show up.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
